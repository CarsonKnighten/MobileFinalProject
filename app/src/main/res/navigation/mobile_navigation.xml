<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.example.mobilefinalproject.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_title"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_strength"
            app:destination="@id/nav_strength_training" />
        <action
            android:id="@+id/action_dashboard_to_calories"
            app:destination="@id/nav_weight_loss" />
    </fragment>

    <fragment
        android:id="@+id/nav_weight_loss"
        android:name="com.example.mobilefinalproject.ui.weightloss.WeightLossFragment"
        android:label="@string/menu_weight_loss"
        tools:layout="@layout/fragment_weight_loss" />

    <include app:graph="@navigation/strength_navigation" />
</navigation>
